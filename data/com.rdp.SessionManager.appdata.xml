<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.rdp.SessionManager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>RDP Session Manager</name>
  <summary>RDP session manager for GNOME</summary>

  <description>
    <p>
      RDP Session Manager is a GTK4 application for GNOME that allows you to create,
      manage and monitor RDP sessions easily and intuitively.
    </p>
    <p>Key Features:</p>
    <ul>
      <li>Modern graphical interface using GTK4</li>
      <li>Automated RDP user creation</li>
      <li>Support for multiple graphical environments (GNOME, XFCE, KDE)</li>
      <li>Centralized session management</li>
      <li>Real-time status monitoring</li>
      <li>PolicyKit integration for security</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.rdp.SessionManager.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Main manager window</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/Pedroltz/rdp-session-manager</url>
  <url type="bugtracker">https://github.com/Pedroltz/rdp-session-manager/issues</url>

  <provides>
    <binary>rdp-session-manager</binary>
  </provides>

