<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="UserDialog" parent="AdwDialog">
    <property name="title">Create a New RDP User</property>
    <property name="content-width">500</property>
    <property name="content-height">680</property>
    <property name="can-close">true</property>

    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="cancel_button">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="create_button">
                <property name="label">Create</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <child>
              <object class="AdwClamp">
                <property name="maximum-size">500</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>

                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>

                    <!-- Basic Info -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title">Basic Information</property>

                        <child>
                          <object class="AdwEntryRow" id="username_entry">
                            <property name="title">Username</property>
                            <property name="show-apply-button">false</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwEntryRow" id="fullname_entry">
                            <property name="title">Full Name</property>
                            <property name="show-apply-button">false</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Security -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title">Security</property>

                        <child>
                          <object class="AdwPasswordEntryRow" id="password_entry">
                            <property name="title">Password</property>
                          </object>
                        </child>

                        <child>
                          <object class="AdwPasswordEntryRow" id="confirm_password_entry">
                            <property name="title">Confirm Password</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Session Type -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title">Session Type</property>
                        <property name="description">Choose between full desktop or single app</property>

                        <child>
                          <object class="AdwComboRow" id="session_type_combo">
                            <property name="title">Connection Mode</property>
                            <!-- Model is set dynamically in setup_session_type_combo() -->
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Desktop Environment -->
                    <child>
                      <object class="GtkBox" id="desktop_container">
                        <property name="orientation">vertical</property>
                        <property name="height-request">180</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="desktop_group">
                            <property name="title">Desktop Environment</property>
                            <property name="description">Choose the graphical environment for this user</property>

                            <child>
                              <object class="AdwComboRow" id="de_combo">
                                <property name="title">Desktop Environment</property>
                                <!-- Model is set dynamically in setup_de_combo() -->
                              </object>
                            </child>

                            <child>
                              <object class="AdwActionRow" id="install_de_row">
                                <property name="title">Install Desktop Environment</property>
                                <property name="subtitle">Download and install if not available</property>
                                <child>
                                  <object class="GtkSwitch" id="install_de_switch">
                                    <property name="valign">center</property>
                                    <property name="active">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- RemoteApp Settings -->
                    <child>
                      <object class="GtkBox" id="remoteapp_container">
                        <property name="orientation">vertical</property>
                        <property name="height-request">180</property>
                        <property name="visible">false</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="remoteapp_group">
                            <property name="title">RemoteApp Settings</property>
                            <property name="description">Configure the Linux application to run</property>

                            <child>
                              <object class="AdwComboRow" id="app_combo">
                                <property name="title">Application</property>
                                <!-- Model is set dynamically in setup_app_combo() -->
                              </object>
                            </child>

                            <child>
                              <object class="AdwEntryRow" id="custom_app_entry">
                                <property name="title">Custom Command</property>
                                <property name="show-apply-button">false</property>
                                <property name="visible">false</property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwEntryRow" id="app_args_entry">
                                <property name="title">Arguments (optional)</property>
                                <property name="show-apply-button">false</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- WineGE RemoteApp Settings -->
                    <child>
                      <object class="GtkBox" id="winege_container">
                        <property name="orientation">vertical</property>
                        <property name="height-request">180</property>
                        <property name="visible">false</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="winege_group">
                            <property name="title">Windows application (WineGE)</property>
                            <property name="description">Configure the Windows executable to run</property>

                            <child>
                              <object class="AdwActionRow" id="exe_file_row">
                                <property name="title">Select File</property>
                                <property name="subtitle">Choose the .exe executable from your computer</property>
                                <child>
                                  <object class="GtkButton" id="exe_file_button">
                                    <property name="label">Select</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="suggested-action"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwEntryRow" id="exe_path_entry">
                                <property name="title">Executable Path</property>
                                <property name="show-apply-button">false</property>
                                <property name="editable">true</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Connection Settings -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title">Connection Settings</property>

                        <child>
                          <object class="AdwActionRow" id="auto_start_row">
                            <property name="title">Start Automatically</property>
                            <property name="subtitle">Start the RDP session with the system</property>
                            <child>
                              <object class="GtkSwitch" id="auto_start_switch">
                                <property name="valign">center</property>
                                <property name="active">true</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
