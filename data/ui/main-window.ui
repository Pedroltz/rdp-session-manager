<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="MainWindow" parent="AdwApplicationWindow">
    <property name="default-width">600</property>
    <property name="default-height">850</property>
    <property name="title">RDP Session Manager</property>

    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <child type="start">
              <object class="GtkButton" id="add_user_button">
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text">Create a new RDP user</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>

            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>

        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>

            <!-- Search Bar -->
            <child>
              <object class="GtkSearchBar" id="search_bar">
                <property name="search-mode-enabled">false</property>
                <child>
                  <object class="GtkSearchEntry" id="search_entry">
                    <property name="placeholder-text">Search users...</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Main Content -->
            <child>
              <object class="GtkStack" id="main_stack">
                <property name="vexpand">true</property>

                <!-- Users List Page -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">users_list</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="spacing">12</property>

                            <!-- Server Info Card -->
                            <child>
                              <object class="AdwPreferencesGroup" id="server_info_group">
                                <property name="title">Server Information</property>
                                <child>
                                  <object class="AdwActionRow" id="ip_row">
                                    <property name="title">IP Address</property>
                                    <property name="subtitle" bind-source="ip_row" bind-property="subtitle" bind-flags="sync-create"/>
                                    <child>
                                      <object class="GtkButton" id="copy_ip_button">
                                        <property name="icon-name">edit-copy-symbolic</property>
                                        <property name="valign">center</property>
                                        <property name="tooltip-text">Copy IP</property>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="sessions_row">
                                    <property name="title">Active Sessions</property>
                                    <property name="subtitle">0 sessions</property>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <!-- Users List -->
                            <child>
                              <object class="AdwPreferencesGroup" id="users_group">
                                <property name="title">RDP Users</property>
                                <property name="description">Click on a user to see details</property>
                                <child>
                                  <object class="GtkListBox" id="users_listbox">
                                    <property name="selection-mode">none</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Empty State -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">empty</property>
                    <property name="child">
                      <object class="AdwStatusPage">
                        <property name="icon-name">avatar-default-symbolic</property>
                        <property name="title">No RDP Users</property>
                        <property name="description">Create your first RDP user to get started</property>
                        <child>
                          <object class="GtkButton" id="empty_add_user_button">
                            <property name="label">Create User</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>

  <!-- Primary Menu -->
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label">Settings</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label">Sobre</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
