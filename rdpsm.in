#!@PYTHON@
"""
RDPSM - RDP Session Manager CLI
Command-line interface for RDP Session Manager
"""

import sys
import os

# Add installation directory to Python path
pkgdatadir = '@PKGDATADIR@'
if os.path.exists(pkgdatadir):
    sys.path.insert(1, pkgdatadir)

# Import and run CLI
try:
    from cli import main
except ImportError:
    # Fallback for development mode
    from pathlib import Path
    src_dir = Path(__file__).parent / 'src'
    if src_dir.exists():
        sys.path.insert(0, str(src_dir))
        from cli import main
    else:
        print("Error: Could not find CLI module", file=sys.stderr)
        print("Please reinstall RDP Session Manager", file=sys.stderr)
        sys.exit(1)

if __name__ == '__main__':
    main()
